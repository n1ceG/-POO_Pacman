<mxfile host="app.diagrams.net"><diagram id="seq-req9" name="Req. 9 - Victoria"><mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="&lt;b&gt;sd&lt;/b&gt; Req. 9: Victoria" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=280;height=30;fillColor=none;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1210" height="850" as="geometry"/></mxCell><mxCell id="ll-reloj" value="Reloj del juego" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=nowrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;portConstraint=eastwest;size=40;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="65" y="50" width="30" height="800" as="geometry"/></mxCell><mxCell id="ll-ctrl" value=":ControladorJuego" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="160" y="50" width="140" height="800" as="geometry"/></mxCell><mxCell id="ll-partida" value=":Partida" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="50" width="120" height="800" as="geometry"/></mxCell><mxCell id="ll-pac" value=":PacMan" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1"