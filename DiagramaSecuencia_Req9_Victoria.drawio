><mxPoint x="430" y="492" as="sourcePoint"/><mxPoint x="1135" y="492" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r7" value="v" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;endSize=8;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135" y="510" as="sourcePoint"/><mxPoint x="430" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-puntaje" value="puntaje += v" style="text;html=1;align=left;verticalAlign=middle;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="438" y="514" width="100" height="20" as="geometry"/></mxCell><mxCell id="note-poli" value="&lt;b&gt;valor()&lt;/b&gt; es polimórfico: PuntoComun devuelve 10 y SuperPunto 50 (Req. 3). Si es súper punto, además asusta a los fantasmas (Req. 5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="880" y="520" width="330" height="52" as="geometry"/></mxCell><mxCell id="note-poli-link" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="520" as="sourcePoint"/><mxPoint x="1136" y="512" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8" value="8: victoria = comprobarVictoria()" style="html=1;align=left;spacingLeft=4;verticalAlign=middle;endArrow=block;endFill=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425" y="575" as="sourcePoint"/><mxPoint x="430" y="593" as="targetPoint"/><Array as="points"><mxPoint x="465" y="575"/><mxPoint x="465" y="593"/></Array><mxPoint x="2" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="m9" value="9: quedan = quedanPuntos()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="612" as="sourcePoint"/><mxPoint x="790" y="612" as="targetPoint"/></mxGeometry></mxCell><mxCell id="loop" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=44;height=22;fillColor=none;" vertex="1" parent="1"><mxGeometry x="745" y="628" width="300" height="62" as="geometry"/></mxCell><mxCell id="g-loop" value="[cada celda, hasta hallar un punto]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="805" y="629" width="235" height="20" as="geometry"/></mxCell><mxCell id="m10" value="10: tienePunto()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;strokeColor=#d9822b;fontColor=#b8631a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="664" as="sourcePoint"/><mxPoint x="965" y="664" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r10" value="tiene" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;endSize=8;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965" y="680" as="sourcePoint"/><mxPoint x="800" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r9" value="quedan" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;endSize=8;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="705" as="sourcePoint"/><mxPoint x="430" y="705" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t-vic" value="victoria = !quedan" style="text;html=1;align=left;verticalAlign=middle;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="438" y="708" width="140" height="20" as="geometry"/></mxCell><mxCell id="opt2" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=40;height=22;fillColor=none;" vertex="1" parent="1"><mxGeometry x="375" y="740" width="290" height="52" as="geometry"/></mxCell><mxCell id="g2" value="[victoria]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="432" y="741" width="80" height="20" as="geometry"/></mxCell><mxCell id="t-estado" value="estado = VICTORIA" style="text;html=1;align=left;verticalAlign=middle;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="438" y="764" width="150" height="22" as="geometry"/></mxCell><mxCell id="note-fin" value="La partida terminó: los próximos &lt;b&gt;actualizar(t)&lt;/b&gt; no hacen nada, porque el estado ya no es EN_CURSO, y el jugador puede iniciar una nueva partida (Req. 10)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="690" y="736" width="440" height="60" as="geometry"/></mxCell><mxCell id="note-fin-link" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="766" as="sourcePoint"/><mxPoint x="665" y="766" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;En naranja: métodos que hay que agregar al diagrama de clases para que esta secuencia sea posible&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ControladorJuego.avanzarTiempo(t)&lt;/b&gt;: punto de entrada de cada paso del juego (el mismo que usa el diagrama del Req. 1). En la versión final lo llama un Timer de Swing.&lt;br&gt;• &lt;b&gt;Personaje.getPosicion(): Posicion&lt;/b&gt;: posicion es privado y Partida necesita saber en qué celda quedó Pac-Man. PacMan lo hereda.&lt;br&gt;• &lt;b&gt;Laberinto.retirarPunto(posicion): Punto&lt;/b&gt;: Partida no conoce a las celdas. El laberinto busca la celda en celdas[fila][columna] y le delega a Celda.retirarPunto(), que ya existe.&lt;br&gt;• &lt;b&gt;Celda.tienePunto(): boolean&lt;/b&gt;: quedanPuntos() tiene que recorrer las celdas, pero Celda.punto es privado.&lt;br&gt;&lt;b&gt;Además:&lt;/b&gt; el bloque &lt;b&gt;ref&lt;/b&gt; reutiliza el diagrama del Req. 1 (movimiento) para no dibujarlo dos veces." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#fff4e6;strokeColor=#d9822b;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1210" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
